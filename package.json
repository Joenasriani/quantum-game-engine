{
  "name": "quantum-game-engine",
  "version": "1.0.0",
  "description": "Experimental TypeScript browser game engine prototype with scene, object, tilemap, state, prefab, vector, and tween modules",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && webpack",
    "dev": "webpack serve",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "game-engine",
    "typescript",
    "browser-games",
    "tilemap",
    "tween"
  ],
  "author": "Joe Nasr",
  "license": "MIT",
  "dependencies": {
    "three": "^r150",
    "cannon-es": "^0.20.0",
    "earcut": "^2.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.0",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.1"
  }
}
